Table attribute {
  id bigint [pk]
  code varchar [unique]
  description varchar [not null]
  name_kh varchar
  type varchar
  values_text varchar
  active boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp
}

Table attribute_change_log {
  id bigint [pk]
  product_id bigint [not null]
  attribute_name varchar [not null]
  old_value varchar
  new_value varchar [not null]
  reason varchar
  changed_by varchar
  changed_at timestamp [not null]
  product_name varchar
}

Table brand {
  id bigint [pk]
  code varchar [unique]
  description varchar [not null]
  name_kh varchar
  active boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp
}

Table category {
  id bigint [pk]
  code varchar [unique]
  description varchar [not null]
  name_kh varchar
  active boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp
}

Table cost_change_log {
  id bigint [pk]
  product_id bigint [not null]
  old_cost numeric
  new_cost numeric
  adjustment_type varchar
  adjustment_value numeric
  reason varchar
  changed_by varchar
  changed_at timestamp [not null]
  product_name varchar
}

Table issue_document {
  id bigint [pk]
  code varchar [unique, not null]
  doc_date date [not null]
  issue_type varchar
  reference varchar
  issued_by varchar
  outlet varchar
  note varchar
  total_cost numeric
  status varchar [not null]
  created_at timestamp [not null]
