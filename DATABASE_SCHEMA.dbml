// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs
// Project: B'Groceries ERP & Supermarket Management System

Table activity_logs {
  id bigint [pk]
  username varchar [not null]
  user_role varchar
  user_full_name varchar
  action_type varchar [not null]
  entity_type varchar [not null]
  entity_id bigint
  entity_name varchar
  description varchar [not null]
  icon varchar
  status varchar
  ip_address varchar
  created_at timestamp [not null]
}

Table job {
  id bigint [pk]
  title varchar [not null]
  department varchar [not null]
  location varchar [not null]
  type varchar [not null]
  salary varchar
  description varchar
  requirements varchar
  benefits varchar
  created_at timestamp [not null]
  updated_at timestamp
}

Table job_application {
  id bigint [pk]
  job_id bigint [not null]
  full_name varchar [not null]
  email varchar [not null]
  phone varchar [not null]
  linkedin_url varchar
  cover_letter varchar
  resume_name varchar
  resume_data varchar
  resume_content_type varchar
  status varchar [not null]
  created_at timestamp [not null]
}

Table member {
  id bigint [pk]
  member_code varchar [unique, not null]
  full_name varchar [not null]
  position varchar
  rank integer
  department varchar
  category varchar
  photo_url varchar
  member_detail bigint
  created_at timestamp [not null]
  updated_at timestamp
}

Table member_detail {
  id bigint [pk]
  member bigint [unique, not null]
  phone_number varchar
  email varchar
  address varchar
  date_of_birth date
  gender varchar
  emergency_contact varchar
  start_date date
  note varchar
  nationality varchar
}

Table login_sessions {
  id bigint [pk]
  token varchar [unique, not null]
  telegram_user_id bigint
  telegram_username varchar
  telegram_first_name varchar
  status varchar [not null]
  jwt_token varchar
  expires_at timestamp [not null]
  created_at timestamp [not null]
}

Table otp_codes {
  id bigint [pk]
  phone_number varchar [not null]
  code_hash varchar [not null]
  purpose varchar [not null]
  expires_at timestamp [not null]
  used boolean [not null]
  verified boolean [not null]
  attempts integer [not null]
  created_at timestamp [not null]
}

Table password_reset_otps {
  id bigint [pk]
  email varchar [not null]
  code_hash varchar [not null]
  expires_at timestamp [not null]
  used boolean [not null]
  verified boolean [not null]
  attempts integer [not null]
  created_at timestamp [not null]
}

Table requisitions {
  id bigint [pk]
  code varchar [unique, not null]
  date date
  require_date date
  template_name varchar
  requisition_type varchar
  requisition_amount float
  reference varchar
  reference_code varchar
  user_name varchar
  status varchar
  note varchar
  created_at timestamp
  updated_at timestamp
}

Table requisition_items {
  id bigint [pk]
  requisition_id bigint [not null]
  product_id bigint
  code varchar
  barcode varchar
  description varchar
  requisition_qty float
  uom varchar
  cost float
  total float
}

Table aging_invoices {
  id bigint [pk]
  code varchar [unique, not null]
  invoice_date date [not null]
  due_date date
  customer varchar [not null]
  contact_name varchar
  phone varchar
  status varchar [not null]
  grand_total numeric [not null]
  balance numeric [not null]
  salesperson varchar
  customer_group varchar
  created_at timestamp [not null]
  updated_at timestamp
}

Table ar_collections {
  id bigint [pk]
  code varchar [unique, not null]
  payment_date timestamp [not null]
  rate numeric
  paid_amount numeric [not null]
  balance numeric
  current_amount numeric
  remain_amount numeric
  customer_id bigint
  customer varchar [not null]
  contact varchar
  user_name varchar
  status varchar [not null]
  note varchar
  apply_method varchar
  payment_type varchar
  authorization_note varchar
  created_at timestamp
  updated_at timestamp
}

Table ar_collection_invoices {
  id bigint [pk]
  ar_collection_id bigint [not null]
  inv_code varchar
  inv_date timestamp
  due_date timestamp
  currency varchar
  rate numeric
  amount numeric
  balance numeric
  discount numeric
  pay_amount numeric
  pay_currency varchar
}

Table consignments {
  id bigint [pk]
  code varchar [unique, not null]
  consignment_date timestamp [not null]
  delivery_date timestamp
  customer_id bigint
  customer_name varchar
  customer_phone varchar
  customer_address varchar
  salesperson varchar
  payment_term varchar
  outlet varchar
  template_name varchar
  status varchar [not null]
  sub_amount numeric
  discount_percent numeric
  discount_amount numeric
  tax_amount numeric
  grand_total numeric [not null]
  balance numeric
  reference varchar
  username varchar
  note varchar
  billing_name varchar
  billing_phone varchar
  billing_email varchar
  billing_address varchar
  shipping_recipient varchar
  shipping_phone varchar
  shipping_address varchar
  shipping_courier varchar
  created_at timestamp
  updated_at timestamp
}

Table consignment_items {
  id bigint [pk]
  consignment_id bigint [not null]
  product_id bigint
  product_code varchar
  barcode varchar
  description varchar [not null]
  qty numeric [not null]
  price numeric [not null]
  discount numeric
  uom varchar
  total numeric [not null]
  note varchar
}

Table customer {
  id bigint [pk]
  code varchar [unique]
  customer_name varchar [not null]
  second_language varchar
  customer_group varchar
  sale_employee varchar
  tax_no varchar
  payment_term varchar
  terms_and_condition varchar
  price_book varchar
  quote_template varchar
  so_template varchar
  invoice_template varchar
  do_template varchar
  allow_credit boolean [not null]
  credit_limit numeric
  current_balance numeric
  credit_deposit numeric
  balance numeric
  contact_first_name varchar
  contact_last_name varchar
  contact_gender varchar
  contact_dob date
  contact_phone varchar
  contact_mobile varchar
  contact_email varchar
  contact_website varchar
  address_description varchar
  address_second_language varchar
  address_line1 varchar
  address_line2 varchar
  address_city varchar
  address_state varchar
  address_country varchar
  address_phone varchar
  address_phone_ext varchar
  address_fax varchar
  address_fax_ext varchar
  address_email varchar
  address_website varchar
  active boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp
}

Table customer_deposits {
  id bigint [pk]
  code varchar [unique, not null]
  deposit_date timestamp [not null]
  amount numeric [not null]
  customer_id bigint
  customer_name varchar [not null]
  contact varchar
  payment_type varchar
  reference varchar
  username varchar
  status varchar [not null]
  note varchar
  created_at timestamp
  updated_at timestamp
}

Table customer_group {
  id bigint [pk]
  code varchar [unique]
  description varchar [not null]
  second_language varchar
  active boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp
}

Table customer_refunds {
  id bigint [pk]
  code varchar [unique, not null]
  payment_date timestamp [not null]
  rate numeric
  paid_amount numeric [not null]
  balance numeric
  customer_id bigint
  partner varchar [not null]
  contact varchar
  phone varchar
  user_name varchar
  status varchar [not null]
  note varchar
  payment_type varchar
  authorization_note varchar
