}

Table payment_terms {
  id bigint [pk]
  code varchar [unique, not null]
  description varchar [not null]
  second_language varchar
  days integer [not null]
  active boolean [not null]
  note varchar
  created_at timestamp
  updated_at timestamp
}

Table quotation {
  id bigint [pk]
  code varchar [unique, not null]
  quotation_date timestamp [not null]
