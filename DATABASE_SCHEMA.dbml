  on_hand numeric
  uom varchar
  base_price numeric
  average_cost numeric
  standard_cost numeric
  create_date date
  country varchar
  supplier varchar
  part_number varchar
  brand varchar
  on_po numeric
  on_so numeric
  available_stock numeric
  active boolean [not null]
  serial varchar
  expiry_date date
  allow_discount boolean [not null]
  tax numeric
  out_of_stock boolean [not null]
  favorite boolean [not null]
  image_url varchar
  created_at timestamp [not null]
  updated_at timestamp
}

Table product_group {
  id bigint [pk]
  code varchar [unique]
  description varchar [not null]
  name_kh varchar
  active boolean [not null]
