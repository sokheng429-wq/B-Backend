Table transfer_document {
  id bigint [pk]
  code varchar [unique, not null]
  doc_type varchar [not null]
  transfer_date date [not null]
  required_date date
  request_transfer_date date
  from_outlet varchar
  from_location varchar
  to_outlet varchar
  to_location varchar
